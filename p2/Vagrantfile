# -*- mode: ruby -*-
# vi: set ft=ruby :

# ──────────────────────────────────────────────────
# Inception-of-Things — Part 2: K3s and three apps
# ──────────────────────────────────────────────────

SERVER_IP   = "192.168.56.110"
K3S_TOKEN   = "iot-secret-token-42"
BOX_IMAGE   = "debian/bookworm64"

Vagrant.configure("2") do |config|

  config.vm.box = BOX_IMAGE

  config.vm.define "ojamalS" do |server|
    server.vm.hostname = "ojamalS"
    server.vm.network "private_network", ip: SERVER_IP

    server.vm.provider "virtualbox" do |v|
      v.customize ["modifyvm", :id, "--name", "ojamalS"]
      v.memory = 1024
      v.cpus   = 1
    end

    # Sync confs folder into the VM
    server.vm.synced_folder "confs", "/vagrant/confs"

    server.vm.provision "shell",
      path: "scripts/server.sh",
      env: {
        "K3S_TOKEN"  => K3S_TOKEN,
        "SERVER_IP"  => SERVER_IP,
      }
  end

end
